# 运行环境：development / staging / production
APP_ENV=development
DEBUG=false

# PostgreSQL（推荐 asyncpg；也可用 postgresql://，启动时会自动转换）
# 云库通常需要 SSL：追加 ?sslmode=require
ASYNC_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# DashScope API 密钥
DASHSCOPE_API_KEY=your-dashscope-api-key

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# JWT（请使用足够长的随机串）
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Refresh Cookie Secure；不填则生产环境自动为 true
# COOKIE_SECURE=false
